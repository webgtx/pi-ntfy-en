{
  "_note": "pi-ntfy-en only supports NTFY. Copy to ~/.pi/agent/pi-ntfy.json and adjust as needed.",
  "_placeholders": "{{status}} {{reason}} {{text}} {{title}} {{event}} {{cwd}} {{project}} {{duration}} {{session}} {{sessionId}} {{model}} {{mode}} {{thinking}} {{task}} {{summary}} {{tools}} {{host}} {{time}} {{date}}",
  "enabled": true,
  "modes": ["tui"],
  "timeoutMs": 5000,
  "shutdownTimeoutMs": 2000,
  "dedupeMs": 3000,
  "minDurationSec": 0,
  "maxTextChars": 2000,
  "debug": false,
  "titleTemplate": "[{{project}}] {{status}} · {{session}}",
  "template": "Project: {{project}}\nSession: {{session}}\nTask: {{task}}\nStatus: {{status}}\nReason: {{reason}}\nSummary: {{summary}}\nDuration: {{duration}}\nModel: {{model}}\nHost: {{host}}\nTime: {{date}} {{time}}\nTools: {{tools}}",
  "events": {
    "idle": true,
    "interrupted": true,
    "needInput": true,
    "exit": false
  },
  "needInputTools": ["ask_user_question", "plan_mode_question"],
  "channels": [
    {
      "type": "ntfy",
      "name": "Phone ntfy",
      "enabled": true,
      "topic": "Agent",
      "server": "https://ntfy.sh",
      "token": "$NTFY_TOKEN",
      "priority": "default",
      "tags": "pi,computer"
    }
  ]
}
